#!/bin/sh
#
# Prepare HybridOS runtime state for a systemd-booted Kali session.
#

LOG="/var/log/kali-hybridos-prepare.log"
STATE_DIR="/run/hybridos"
ENV_FILE="$STATE_DIR/env"

mkdir -p /var/log "$STATE_DIR" 2>/dev/null
echo "=== kali-hybridos-prepare START ===" > "$LOG"
date >> "$LOG" 2>/dev/null

for dir in /system_root /system /vendor /mnt/vendor/persist /config; do
    if [ -e "$dir" ]; then
        echo "found $dir" >> "$LOG"
    else
        echo "missing $dir" >> "$LOG"
    fi
done

cat > "$ENV_FILE" <<'EOF'
ANDROID_ROOT=/system
ANDROID_DATA=/data
HYBRIDOS_BOOT=1
EOF

chmod 0644 "$ENV_FILE"
echo "wrote $ENV_FILE" >> "$LOG"
exit 0
