#!/system/bin/sh
# Kali Native Weston Launcher
# Simpler than phosh - uses weston directly without libhybris
# Useful for testing the GUI pipeline

DISTRO="kali_native"
STOWAWAY="/data/.stowaway"
CHROOT="$STOWAWAY/$DISTRO"
LOG="$CHROOT/var/log/weston-start.log"

log() {
    echo "[$(date +%H:%M:%S)] [kali-native Weston] $*" 
    echo "[$(date +%H:%M:%S)] [kali-native Weston] $*" >> "$LOG" 2>/dev/null
}

check_rootfs() {
    [ -d "$CHROOT" ] && [ -x "$CHROOT/usr/bin/weston" ] || return 1
    return 0
}

do_mounts() {
    log "Setting up mounts..."
    for tmp in proc sys dev run tmp; do
        dst="$CHROOT/$tmp"
        [ ! -d "$dst" ] && mkdir -p "$dst"
        case "$tmp" in
            proc) mount -t proc proc "$dst" 2>/dev/null ;;
            sys) mount -t sysfs sysfs "$dst" 2>/dev/null ;;
            dev) mount -t devtmpfs devtmpfs "$dst" 2>/dev/null ;;
            run|tmp) mount -t tmpfs tmpfs "$dst" 2>/dev/null ;;
        esac
    done
    mkdir -p "$CHROOT/run/user/100000"
    chown 100000:100000 "$CHROOT/run/user/100000" 2>/dev/null
    log "Mounts ready"
}

do_start() {
    log "=== Starting Kali Native Weston ==="
    
    check_rootfs || { log "ERROR: weston not found"; return 1; }
    do_mounts
    
    log "Starting weston as user kali..."
    
    # Start weston with drm backend (for GL)
    chroot "$CHROOT" /bin/su - kali -c "
        export XDG_RUNTIME_DIR=/run/user/100000
        export WAYLAND_DISPLAY=wayland-0
        export MOZ_EGL_USE_DRM=1
        export GBM_BACKEND=dri
        export WLR_NO_HARDWARE_CURSORS=1
        /usr/bin/weston --backend=drm-backend.so --idle-time=0
    " &
    
    log "Weston started (PID: $!)"
    log "Connect: kaos-starter --distro $DISTRO exec /bin/bash"
}

case "$1" in
    start) do_start ;;
    stop) pkill -f weston; log "Stopped" ;;
    status) pgrep -f weston > /dev/null && echo "Running" || echo "Not running" ;;
    *) echo "Usage: $0 {start|stop|status}" ;;
esac