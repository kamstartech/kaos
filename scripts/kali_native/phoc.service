[Unit]
Description=Phoc DRM Compositor
After=graphical.target

[Service]
Type=simple
User=100000
Group=100000
Environment=XDG_RUNTIME_DIR=/run/user/100000
Environment=GBM_BACKEND=dri
Environment=EGL_PLATFORM=drm
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/start-phoc
Restart=on-failure

[Install]
WantedBy=graphical.target