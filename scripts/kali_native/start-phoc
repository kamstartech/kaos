#!/bin/bash
# Kali Native - Start Phoc with DRM

export XDG_RUNTIME_DIR=/run/user/100000
export GBM_BACKEND=dri
export EGL_PLATFORM=drm
export MOZ_EGL_USE_DRM=1
export WAYLAND_DISPLAY=wayland-0

mkdir -p $XDG_RUNTIME_DIR
chmod 700 $XDG_RUNTIME_DIR
chown 100000:100000 $XDG_RUNTIME_DIR 2>/dev/null || true

echo "=== Starting phoc with DRM ==="
echo "GBM_BACKEND=$GBM_BACKEND"
echo "EGL_PLATFORM=$EGL_PLATFORM"

exec /usr/bin/phoc --backend=drm-backend.so --idle-time=0 2>&1