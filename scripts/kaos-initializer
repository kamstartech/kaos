#!/system/bin/sh
# Kaos Initializer - runs in Linux mode after boot or on-demand via ctl.start
# Uses distros-lib.sh to find chroot paths (multi-distro aware)
# If chroot not found or fails, falls back to Android mode

LOG_TAG="Kaos"

log_msg() {
    log -t "$LOG_TAG" "$1"
}

# === Load Distro Library ===
SCRIPT_DIR=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
if [ -f "${SCRIPT_DIR}/distros-lib.sh" ]; then
    . "${SCRIPT_DIR}/distros-lib.sh"
elif [ -f "/system/bin/distros-lib.sh" ]; then
    . /system/bin/distros-lib.sh
elif [ -f "/system/bin/distros-lib.sh" ]; then
    . /system/bin/distros-lib.sh
fi

# Resolve active distro (defaults to kali)
if type resolve_distro >/dev/null 2>&1; then
    resolve_distro ""
    CHROOT_DIR="$REAL_CHROOT"
else
    # Fallback: check common locations
    if [ -d "/data/.stowaway/kali" ]; then
        CHROOT_DIR="/data/.stowaway/kali"
    elif [ -d "/data/local/kaos_system/kali-arm64" ]; then
        CHROOT_DIR="/data/local/kaos_system/kali-arm64"
    else
        CHROOT_DIR=""
    fi
fi

# Check if chroot exists
if [ -z "$CHROOT_DIR" ] || [ ! -d "$CHROOT_DIR" ]; then
    log_msg "FALLBACK: Chroot not found, switching to android mode"
    setprop persist.debug.kaos.boot_mode android
    exit 0
fi

# Check if key chroot files exist
if [ ! -f "$CHROOT_DIR/usr/bin/env" ]; then
    log_msg "FALLBACK: Chroot at $CHROOT_DIR appears incomplete, switching to android mode"
    setprop persist.debug.kaos.boot_mode android
    exit 0
fi

# Chroot exists, proceed with startup
log_msg "Chroot found at $CHROOT_DIR, starting namespace"
setprop kaos.status Starting

# Start kaos services
if [ -x /system/bin/kaos-starter ]; then
    /system/bin/kaos-starter start
    setprop kaos.status Ready
    log_msg "Namespace started successfully"
else
    log_msg "FALLBACK: kaos-starter not found, switching to android mode"
    setprop persist.debug.kaos.boot_mode android
fi
